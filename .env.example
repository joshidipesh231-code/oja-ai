# ---------------------------------------------------------------------------
# Oja backend environment variables. Copy to .env and fill in real values.
# NEVER commit a real .env to git and NEVER paste real keys into chat/logs.
# ---------------------------------------------------------------------------

# Port the server listens on.
PORT=3000

# OpenRouter API key for chat completions. Leave empty to disable chat
# (POST /api/chat returns 503 until a key is set). Get a key at:
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Default chat model (must be a valid OpenRouter model id).
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini

# Secret used for session/cookie derivation and future signed tokens.
# Generate a fresh one with:  openssl rand -hex 32
SESSION_SECRET=

# When 'true', OTP codes are returned in the phone/request API response so
# you can sign in without a real SMS provider (development convenience).
# Set to 'false' in production AND make sure demo_code is removed from API
# responses — see the big comment at the top of server/otp.js.
OTP_DEMO_MODE=true

# Directory for the SQLite database file (oja.db is created here).
DATA_DIR=./data

# Directory where uploaded images/videos are stored on disk.
UPLOAD_DIR=./uploads

# Per-user media storage quota in bytes (default 5 GB).
QUOTA_BYTES=5368709120
